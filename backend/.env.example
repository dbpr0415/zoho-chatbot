# Zoho OAuth (required)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=https://YOUR-RAILWAY-URL.railway.app/auth/callback
ZOHO_PORTAL_NAME=your_portal_name_here
ZOHO_API_BASE_URL=https://projectsapi.zoho.in/restapi

# Groq LLM (required) — get free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# App
APP_SECRET_KEY=change-this-to-a-random-secret-string
FRONTEND_URL=https://YOUR-VERCEL-URL.vercel.app
DEBUG=false

# Database — Railway persistent disk mounts at /data
DATABASE_PATH=/data/zoho_assistant.db

# Set automatically by Railway — DO NOT set manually
# RAILWAY_ENVIRONMENT=production
# PORT=8000
